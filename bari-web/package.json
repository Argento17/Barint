{
  "name": "bari",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate-corpus": "node scripts/validate-corpus.mjs",
    "validate-card-stats": "node scripts/validate-card-stats.mjs",
    "generate-page-schema": "ts-json-schema-generator -p src/lib/contracts/comparison-page-contract.ts -t ComparisonPageContract -i bari-page-output-generated-v1 -o schema/page-output-schema.generated.json --jsDoc extended --no-top-ref",
    "diff-page-schema": "npm run generate-page-schema --silent && node scripts/schema/diff-page-schema.mjs",
    "validate-page-schema": "npm run generate-page-schema --silent && node scripts/schema/validate-against-generated-schema.mjs",
    "test:e2e": "playwright test e2e/smoke.spec.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:perf": "playwright test e2e/perf.spec.ts --project=mobile",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "vision": "playwright test e2e/vision-probe.spec.ts",
    "test:e2e:all": "playwright test",
    "analyze": "next experimental-analyze",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5"
  }
}
