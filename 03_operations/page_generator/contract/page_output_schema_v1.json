{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bari-page-output-v1",
  "title": "Bari Category Page Output v1",
  "description": "JSON Schema derived from the union of granola_frontend_v1.json and snacks_frontend_v2.json (the two working BariProductVM-based corpora). Milk uses a separate legacy format (milk-comparison.json) not covered here.",
  "type": "object",
  "required": ["_meta", "products"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["generated", "category", "product_count"],
      "properties": {
        "generated": {
          "type": "string",
          "description": "ISO-8601 generation timestamp"
        },
        "category": {
          "type": "string",
          "description": "Category slug matching the registry"
        },
        "product_count": {
          "type": "integer",
          "description": "Number of product objects in the products array"
        },
        "scored_count": {
          "type": "integer",
          "description": "Number of products with a non-null score"
        },
        "schema": {
          "type": "string",
          "description": "Schema identifier, e.g. BariProductVM[]"
        },
        "version": {
          "type": "string",
          "description": "Export version string"
        },
        "expansion": {
          "type": "string",
          "description": "Expansion system identifier, e.g. interpretive_expansion_system_v2"
        },
        "source_run_id": {
          "type": "string",
          "description": "Source scrape/run identifier"
        },
        "scope_note": {
          "type": "string",
          "description": "Hebrew scope/editorial note"
        },
        "editorial_note": {
          "type": "string",
          "description": "Editorial curation note"
        },
        "provenance": {
          "type": "string",
          "description": "Score/corpus provenance changelog"
        },
        "production_pass": {
          "type": "string",
          "description": "Production pipeline changelog"
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "score", "grade", "insightLine", "confidence", "expansion"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique product identifier (bsip1_<type>_<barcode> or snk-NNN format)"
          },
          "name": {
            "type": "string",
            "description": "Hebrew product display name"
          },
          "imageUrl": {
            "type": ["string", "null"],
            "description": "Product image URL; null when unavailable"
          },
          "score": {
            "type": ["number", "null"],
            "description": "Bari score 0-100; null for INSUFFICIENT products (float accepted)"
          },
          "grade": {
            "type": ["string", "null"],
            "description": "Letter grade S/A/B/C/D/E or null"
          },
          "insightLine": {
            "type": "string",
            "description": "Pre-authored one-line consumer insight"
          },
          "confidence": {
            "type": "string",
            "enum": ["full", "partial", "insufficient", "verified"],
            "description": "Data confidence level (3-state v2 + verified for milk)"
          },
          "expansion": {
            "type": "object",
            "required": ["nutrition", "ingredients", "confidenceLabel", "servingNote", "positiveSignals", "comparisonContext"],
            "properties": {
              "nutrition": {
                "type": ["object", "null"],
                "description": "Per-100g nutrition values. All sub-fields nullable: null = data unavailable. Present on every product (may be all-null).",
                "properties": {
                  "energyKcal": { "type": ["number", "null"] },
                  "protein": { "type": ["number", "null"] },
                  "sugar": { "type": ["number", "null"] },
                  "fat": { "type": ["number", "null"] },
                  "fiber": { "type": ["number", "null"] },
                  "sodium": { "type": ["number", "null"] }
                },
                "additionalProperties": false
              },
              "ingredients": {
                "type": ["string", "null"],
                "description": "Full ingredients text. Null when unavailable."
              },
              "confidenceLabel": {
                "type": "string",
                "description": "Pre-rendered Hebrew confidence label"
              },
              "servingNote": {
                "type": "string",
                "description": "Serving size annotation, e.g. ל-100 גרם"
              },
              "positiveSignals": {
                "type": "array",
                "items": { "type": "string" },
                "description": "1-3 observable strengths (Hebrew strings)"
              },
              "limitingFactors": {
                "type": "array",
                "items": { "type": "string" },
                "description": "0-2 compositional limits (Hebrew strings). Absent when no limits identified."
              },
              "unknowns": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Data gaps Bari could not verify (Hebrew). Category-level invariant."
              },
              "caveats": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Product-level caveats (Hebrew). Not yet present in any corpus."
              },
              "bottomLine": {
                "type": "string",
                "description": "Editorial synthesis — בשורה התחתונה (Hebrew). Category-level invariant."
              },
              "comparisonContext": {
                "type": "string",
                "description": "Shelf-relative context without algorithm vocabulary (Hebrew)"
              },
              "consumerExplanation": {
                "description": "Extension field: structured consumer explanation (pre-copy or object)."
              }
            },
            "additionalProperties": false
          },
          "rowVerdict": {
            "type": "string",
            "description": "2-3 sentence editorial verdict on the collapsed row. Category-level invariant."
          },
          "rowReason": {
            "type": "object",
            "description": "Short strongest +/− for collapsed row. Synthesized by page-data layer, not in source JSON.",
            "properties": {
              "positive": { "type": ["string", "null"] },
              "limiting": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "metrics": {
            "type": "object",
            "description": "Display-only metric block. Synthesized by page-data layer, not in source JSON.",
            "properties": {
              "protein_g": { "type": ["number", "null"] },
              "fiber_g": { "type": ["number", "null"] },
              "sugar_g": { "type": ["number", "null"] },
              "sodium_mg": { "type": ["number", "null"] }
            },
            "additionalProperties": false
          },
          "retailer": {
            "type": "string",
            "description": "Source retailer slug"
          },
          "barcode": {
            "type": "string",
            "description": "Product barcode (13-digit Israeli or internal code)"
          },
          "source_traceability_status": {
            "type": "string",
            "description": "Traceability of source product data"
          },
          "d4_additives": {
            "type": "array",
            "items": { "$ref": "#/definitions/AdditiveEntry" },
            "description": "D4 additive tier entries. Empty array when not gated."
          },
          "d3_processing": {
            "$ref": "#/definitions/BariProcessingSignalVM",
            "description": "D3 processing signal. Absent when not gated."
          },
          "glassBox": {
            "$ref": "#/definitions/BariGlassBoxVM",
            "description": "Glass Box D5/D6 presentation state. Absent when not gated."
          },
          "s_grade_explanation": {
            "type": "string",
            "description": "Pre-authored Hebrew explanation for S-grade products. Absent on non-S grades."
          },
          "confidence_label_he": {
            "type": "string",
            "description": "Backend-prerendered Hebrew confidence label"
          },
          "confidence_tooltip_he": {
            "type": "string",
            "description": "Backend-prerendered Hebrew confidence tooltip"
          },
          "confidence_sub_reason": {
            "type": ["string", "null"],
            "description": "Metadata-only sub-reason enum. Non-rendering."
          },
          "novaGroup": {
            "type": ["integer", "null"],
            "description": "NOVA group 1–4; null when not assessed. (TASK-316 render field)"
          },
          "sugarPer100ml": {
            "type": ["number", "null"],
            "description": "Sugars per 100ml for liquid categories (juices). (TASK-316 render field)"
          },
          "kcalPer100ml": {
            "type": ["number", "null"],
            "description": "Calories per 100ml for liquid categories (juices). (TASK-316 render field)"
          },
          "retailers": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "description": "Retailer availability list (juices). (TASK-316 render field)"
          },
          "_source_retailers": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "description": "Source retailer list (cakes schema alias). (TASK-316 render field)"
          },
          "subPool": {
            "type": ["string", "null"],
            "description": "Juice sub-pool classification. (TASK-316 render field)"
          },
          "_category_routed": {
            "type": ["string", "null"],
            "description": "Cakes category routing decision from trace.category. (TASK-316 render field)"
          },
          "_product_type": {
            "type": ["string", "null"],
            "description": "Hummus product sub-type (e.g. hummus_spread, matbucha). (TASK-316 render field)"
          },
          "_has_phvo": {
            "type": ["boolean", "null"],
            "description": "True if PHVO/PHCS detected in L3 inferred classifications. (TASK-316 render field)"
          },
          "confidence_level": {
            "type": ["string", "null"],
            "description": "Data sufficiency label (sufficient/partial/insufficient). (TASK-316 render field)"
          },
          "d3_processing_signal": {
            "type": "null",
            "description": "Residual null: not in trace_writer output; requires engine edit out of scope for TASK-316."
          },
          "_isChildrens": {
            "type": ["boolean", "null"],
            "description": "Extension field: children's product classification."
          },
          "_subpool": {
            "type": ["string", "null"],
            "description": "Extension field: granola/cereal sub-pool."
          },
          "_wholeGrainClaim": {
            "type": ["boolean", "null"],
            "description": "Extension field: whole-grain claim present."
          },
          "bariInterpretation": {
            "type": ["array", "null"],
            "description": "Extension field: per-dimension interpretation entries (pre-copy)."
          },
          "bestUseCases": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "description": "Extension field: recommended use-case tags."
          },
          "consumerTakeaway": {
            "type": ["string", "null"],
            "description": "Extension field: consumer takeaway (pre-copy placeholder)."
          },
          "_website_cluster": {
            "description": "Internal website-clustering hint (consumed by frontend page-data; not consumer-rendered scoring data). Whitelisted 2026-06-18 — was a stray-property G1 failure."
          }
        },
        "additionalProperties": false
      }
    },
    "page_copy": {
      "description": "Page-level authored copy block (consumed by frontend page-data; not a per-product scoring field). Whitelisted 2026-06-18 — was a stray-property G1 failure."
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AdditiveEntry": {
      "type": "object",
      "required": ["e_number", "name_he", "tier", "function_he", "explanation_he"],
      "properties": {
        "e_number": { "type": "string" },
        "name_he": { "type": "string" },
        "tier": { "type": "string", "enum": ["functional", "likely-neutral", "dose-dependent", "contested", "disclosure-gap", "unclassified"] },
        "function_he": { "type": "string" },
        "explanation_he": { "type": "string" }
      },
      "additionalProperties": false
    },
    "BariGlassBoxVM": {
      "type": "object",
      "required": ["gateState"],
      "properties": {
        "gateState": { "type": "string", "enum": ["unconstrained", "demote", "withhold"] },
        "disclosureCodes": { "type": "array", "items": { "type": "string" } },
        "withheld": { "type": "boolean" },
        "gatedScore": { "type": "number" },
        "gatedGrade": { "type": "string", "enum": ["S", "A", "B", "C", "D", "E"] },
        "partialNote": { "type": ["string", "null"] },
        "withholdReason": { "type": ["string", "null"] },
        "disclosureNotes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "BariProcessingSignalVM": {
      "type": "object",
      "required": ["confidence", "note_he"],
      "properties": {
        "nova_class": { "type": "integer" },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "population_correlation": { "type": "number" },
        "modifier": { "type": "number" },
        "modifier_note": { "type": "string" },
        "note_he": { "type": ["string", "null"] },
        "note_he_mobile": { "type": ["string", "null"] },
        "confidence_note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
